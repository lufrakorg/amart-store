---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
// import { products } from "../data/products";
import { getCollection } from "astro:content";

const rawProducts = await getCollection("products");
const products = rawProducts.map((p: any) => p.data);

const categories = [
    { label: "Tutti", filter: "tutti", key: "collezione.filter_all" },
    { label: "Pantaloni", filter: "pantaloni", key: "collezione.filter_pants" },
    { label: "Maglie", filter: "maglie", key: "collezione.filter_knitwear" },
    { label: "Top & Camicie", filter: "top", key: "collezione.filter_tops" },
    { label: "Abiti", filter: "abiti", key: "collezione.filter_dresses" },
    { label: "Giacche", filter: "giacche", key: "collezione.filter_jackets" },
    {
        label: "Accessori",
        filter: "accessori",
        key: "collezione.filter_accessories",
    },
];
---

<Layout
    title="Collezione — Amart Store Salerno | La praticità prima di tutto"
    description="Catalogo Amart Store Salerno — Pantaloni, maglie, top e camicie, abiti, giacche e accessori. Ordini rapidi su WhatsApp con spedizioni 24/48h."
    activePage="collezione"
>
    <!-- ===== PAGE HEADER ===== -->
    <section
        class="py-16 bg-navy border-b border-gold/20"
        aria-label="Intestazione Collezione"
    >
        <div class="w-full max-w-[1200px] mx-auto px-6 fade-in">
            <p
                class="text-[0.72rem] font-bold tracking-[0.14em] uppercase text-gold-light mb-3"
                data-i18n="collezione.header_eyebrow"
            >
                Catalogo Amart Store Salerno
            </p>
            <h1
                class="font-serif font-semibold text-white mb-3"
                style="font-size:clamp(2.2rem,5.5vw,4rem)"
                data-i18n="collezione.header_title"
            >
                Collezione Donna
            </h1>
            <p
                class="text-[0.95rem] text-white/70 font-normal max-w-[540px]"
                data-i18n="collezione.header_desc"
            >
                Pantaloni, maglie, top, abiti, giacche e accessori. Trova il
                capo ideale e ordinalo con un messaggio WhatsApp.
            </p>
        </div>
    </section>

    <!-- ===== FILTER BAR (pill / floating capsule with sliding bubble) ===== -->
    <div
        class="collection-filter-bar sticky top-[72px] sm:top-[80px] z-[100] flex justify-center px-4 pointer-events-none"
        role="tablist"
        aria-label="Filtra la collezione"
    >
        <div
            class="pointer-events-auto relative flex items-center gap-1.5 overflow-x-auto scroll-smooth [scroll-snap-type:x_proximity] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden bg-white/90 backdrop-blur-xl border border-gold/30 shadow-[0_8px_30px_rgba(27,46,80,0.12)] rounded-full p-1.5 my-2.5 max-w-full"
            id="filter-tabs"
        >
            <div id="filter-bubble" aria-hidden="true"></div>

            {
                categories.map((t, i) => (
                    <button
                        class={`tab-btn relative z-10 flex-shrink-0 px-4 sm:px-5 py-2 rounded-full font-sans text-[0.72rem] font-bold tracking-[0.08em] uppercase cursor-pointer transition-colors duration-200 min-h-[36px] whitespace-nowrap ${i === 0 ? "active text-white" : "text-slate-600 hover:text-navy"}`}
                        data-filter={t.filter}
                        data-i18n={t.key}
                        role="tab"
                        aria-selected={i === 0 ? "true" : "false"}
                    >
                        <span class="tab-label">{t.label}</span>
                    </button>
                ))
            }
        </div>
    </div>

    <!-- ===== PRODUCTS GRID ===== -->
    <section
        class="py-16 sm:py-20 bg-beige-light"
        aria-label="Griglia prodotti"
        id="collection-grid-section"
    >
        <div class="w-full max-w-[1200px] mx-auto px-6">
            <div
                class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 relative min-h-[320px]"
                id="products-grid"
            >
                {
                    products.map((p, i) => (
                        <div
                            class={`product-item-wrap fade-in ${i % 4 === 1 ? "delay-1" : i % 4 === 2 ? "delay-2" : i % 4 === 3 ? "delay-3" : ""}`}
                            data-category={p.category}
                        >
                            <ProductCard
                                id={p.id}
                                name={p.name}
                                category={p.category}
                                categoryLabel={p.categoryLabel}
                                image={p.image}
                                imageAlt={p.imageAlt}
                                sizes={p.sizes}
                                price={p.price}
                                badge={p.badge}
                                badgeType={p.badgeType}
                            />
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ===== LOOKBOOK GALLERY ===== -->
    <section
        class="lookbook-section py-20 md:py-24 bg-beige border-t border-beige-dark overflow-hidden"
        aria-labelledby="lookbook-heading"
    >
        <!-- Header -->
        <div class="w-full max-w-[1200px] mx-auto px-6 mb-10 fade-in">
            <div class="flex items-end justify-between">
                <div>
                    <p
                        class="text-[0.68rem] font-bold tracking-[0.14em] uppercase text-gold-dark mb-3"
                        data-i18n="lookbook.eyebrow"
                    >
                        Look &amp; Ispirazioni
                    </p>
                    <h2
                        id="lookbook-heading"
                        class="font-serif font-semibold text-navy"
                        style="font-size:clamp(1.7rem,3.8vw,2.8rem)"
                        data-i18n="lookbook.title"
                    >
                        Lookbook Amart
                    </h2>
                    <div class="w-7 h-[2px] bg-gold rounded-full mt-3"></div>
                </div>
                <!-- Mobile scroll hint -->
                <div
                    class="md:hidden flex items-center gap-2 mb-1 text-[0.6rem] font-semibold tracking-[0.14em] uppercase text-slate-400"
                    aria-hidden="true"
                >
                    <span data-i18n="lookbook.scroll_hint">Scorri</span>
                    <span class="lookbook-scroll-arrow inline-flex gap-0.5">
                        <span class="w-1 h-1 rounded-full bg-gold-dark/60"
                        ></span>
                        <span class="w-1 h-1 rounded-full bg-gold-dark/40"
                        ></span>
                        <span class="w-1 h-1 rounded-full bg-gold-dark/20"
                        ></span>
                    </span>
                </div>
            </div>
        </div>

        <!-- ── MOBILE: horizontal cinematic strip ── -->
        <div
            class="md:hidden lookbook-mobile-strip flex gap-4 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden pb-2"
            id="lookbook-strip"
        >
            <div class="flex-shrink-0 w-6" aria-hidden="true"></div>

            {
                [
                    {
                        src: "https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=900&q=85",
                        alt: "Look Amart 1",
                        label: "Praticità Elegante",
                        key: "lookbook.look1_title",
                        num: "01",
                    },
                    {
                        src: "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=700&q=85",
                        alt: "Look Amart 2",
                        label: "Freschezza Quotidiana",
                        key: "lookbook.look2_title",
                        num: "02",
                    },
                    {
                        src: "https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?w=700&q=85",
                        alt: "Look Amart 3",
                        label: "Brezza Marina & Colore",
                        key: "lookbook.look3_title",
                        num: "03",
                    },
                    {
                        src: "https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?w=700&q=85",
                        alt: "Look Amart 4",
                        label: "Stile Senza Tempo",
                        key: "lookbook.look4_title",
                        num: "04",
                    },
                ].map((item, i) => (
                    <div
                        class="lookbook-card flex-shrink-0 relative overflow-hidden rounded-2xl group"
                        style="width:70vw;max-width:320px;height:82vw;max-height:480px"
                    >
                        <img
                            src={item.src}
                            alt={item.alt}
                            loading="lazy"
                            class="w-full h-full object-cover transition-transform duration-700 group-active:scale-[1.04]"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-navy-dark/80 via-navy-dark/10 to-transparent" />
                        <div class="absolute top-4 left-4">
                            <span class="font-serif italic text-[2.2rem] font-light text-white/25 leading-none select-none">
                                {item.num}
                            </span>
                        </div>
                        <div class="absolute bottom-0 left-0 right-0 p-5">
                            <div class="backdrop-blur-sm bg-white/8 border border-white/15 rounded-xl px-4 py-3">
                                <p class="text-[0.62rem] font-semibold tracking-[0.22em] uppercase text-gold-light mb-0.5">
                                    Look {item.num}
                                </p>
                                <p
                                    class="text-[0.88rem] font-serif font-light text-white leading-snug"
                                    data-i18n={item.key}
                                >
                                    {item.label}
                                </p>
                            </div>
                        </div>
                    </div>
                ))
            }

            <div class="flex-shrink-0 w-2"></div>
        </div>

        <!-- Mobile dot indicators -->
        <div
            class="md:hidden flex justify-center gap-2 mt-5"
            id="lookbook-dots"
            aria-hidden="true"
        >
            <span
                class="lookbook-dot w-5 h-[3px] rounded-full bg-navy transition-all duration-300"
            ></span>
            <span
                class="lookbook-dot w-2 h-[3px] rounded-full bg-navy/25 transition-all duration-300"
            ></span>
            <span
                class="lookbook-dot w-2 h-[3px] rounded-full bg-navy/25 transition-all duration-300"
            ></span>
            <span
                class="lookbook-dot w-2 h-[3px] rounded-full bg-navy/25 transition-all duration-300"
            ></span>
        </div>

        <!-- ── DESKTOP: editorial magazine layout ── -->
        <div class="hidden md:block w-full max-w-[1200px] mx-auto px-6">
            <div
                style="display:grid;grid-template-columns:2fr 1.1fr 1.1fr 2fr;grid-template-rows:1fr 1fr;gap:10px;height:780px;"
            >
                <!-- ZONE 1 — tall left portrait (row-span-2) -->
                <div
                    class="lookbook-editorial-item fade-in"
                    style="grid-row:span 2;"
                >
                    <div class="lookbook-editorial-inner group">
                        <img
                            src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=900&q=88"
                            alt="Look 01 — Praticità Elegante"
                            loading="lazy"
                        />
                        <div class="lookbook-editorial-overlay">
                            <div class="lookbook-editorial-top">
                                <span class="lookbook-editorial-num">01</span>
                                <span
                                    class="lookbook-editorial-tag"
                                    data-i18n="category.abiti">Abiti</span
                                >
                            </div>
                            <div class="lookbook-editorial-bottom">
                                <p class="lookbook-editorial-subtitle">
                                    Look 01
                                </p>
                                <h3 class="lookbook-editorial-title">
                                    <span data-i18n="lookbook.look1_title"
                                        >Praticità Elegante</span
                                    >
                                </h3>
                                <div class="lookbook-editorial-line"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ZONE 2 — top center-left -->
                <div class="lookbook-editorial-item fade-in delay-1">
                    <div class="lookbook-editorial-inner group">
                        <img
                            src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=700&q=88"
                            alt="Look 02 — Freschezza Quotidiana"
                            loading="lazy"
                        />
                        <div class="lookbook-editorial-overlay">
                            <div class="lookbook-editorial-top">
                                <span class="lookbook-editorial-num">02</span>
                                <span
                                    class="lookbook-editorial-tag"
                                    data-i18n="category.pantaloni"
                                    >Pantaloni</span
                                >
                            </div>
                            <div class="lookbook-editorial-bottom">
                                <p class="lookbook-editorial-subtitle">
                                    Look 02
                                </p>
                                <h3 class="lookbook-editorial-title">
                                    <span data-i18n="lookbook.look2_title"
                                        >Freschezza Quotidiana</span
                                    >
                                </h3>
                                <div class="lookbook-editorial-line"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ZONE 3 — top center-right -->
                <div class="lookbook-editorial-item fade-in delay-2">
                    <div class="lookbook-editorial-inner group">
                        <img
                            src="https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?w=700&q=88"
                            alt="Look 03 — Brezza Marina & Colore"
                            loading="lazy"
                        />
                        <div class="lookbook-editorial-overlay">
                            <div class="lookbook-editorial-top">
                                <span class="lookbook-editorial-num">03</span>
                                <span
                                    class="lookbook-editorial-tag"
                                    data-i18n="category.maglie">Maglie</span
                                >
                            </div>
                            <div class="lookbook-editorial-bottom">
                                <p class="lookbook-editorial-subtitle">
                                    Look 03
                                </p>
                                <h3 class="lookbook-editorial-title">
                                    <span data-i18n="lookbook.look3_title"
                                        >Brezza Marina &amp; Colore</span
                                    >
                                </h3>
                                <div class="lookbook-editorial-line"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ZONE 4 — tall right portrait (row-span-2) -->
                <div
                    class="lookbook-editorial-item fade-in delay-3"
                    style="grid-row:span 2;"
                >
                    <div class="lookbook-editorial-inner group">
                        <img
                            src="https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?w=900&q=88"
                            alt="Look 04 — Stile Senza Tempo"
                            loading="lazy"
                        />
                        <div class="lookbook-editorial-overlay">
                            <div class="lookbook-editorial-top">
                                <span class="lookbook-editorial-num">04</span>
                                <span
                                    class="lookbook-editorial-tag"
                                    data-i18n="category.top">Top</span
                                >
                            </div>
                            <div class="lookbook-editorial-bottom">
                                <p class="lookbook-editorial-subtitle">
                                    Look 04
                                </p>
                                <h3 class="lookbook-editorial-title">
                                    <span data-i18n="lookbook.look4_title"
                                        >Stile Senza Tempo</span
                                    >
                                </h3>
                                <div class="lookbook-editorial-line"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ZONE 5 — central bottom quote box -->
                <div
                    class="lookbook-editorial-text-block fade-in delay-2"
                    style="grid-column:span 2;"
                >
                    <p
                        class="lookbook-editorial-text-eyebrow"
                        data-i18n="collezione.header_eyebrow"
                    >
                        Amart Store Salerno
                    </p>
                    <blockquote
                        class="lookbook-editorial-quote"
                        data-i18n="lookbook.editorial_quote"
                    >
                        &ldquo;La vera eleganza si riconosce dalla naturalezza e
                        dalla comodità con cui la indossi.&rdquo;
                    </blockquote>
                    <p
                        class="lookbook-editorial-text-body"
                        data-i18n="lookbook.editorial_body"
                    >
                        Ogni combinazione nasce per farti sentire sicura, chic e
                        libera di muoverti in ogni momento della tua giornata.
                    </p>
                    <a
                        href="https://wa.me/393472662754"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="lookbook-editorial-cta-sm"
                        data-i18n="lookbook.editorial_cta"
                    >
                        Richiedi il tuo look via WhatsApp &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- CTA -->
        <div class="text-center mt-12 px-6 fade-in">
            <a
                href="https://www.instagram.com/amartstore_salerno?igsi=c2NyNHp3MXhzczZi&utm_source=qr"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 justify-center px-8 py-3.5 border border-navy rounded-full text-[0.7rem] font-medium tracking-[0.2em] uppercase text-navy hover:bg-navy hover:text-white transition-all duration-300 min-h-[48px] hover:scale-105"
                data-i18n="lookbook.instagram_btn"
            >
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    ><path
                        d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                    ></path></svg
                >
                Seguici su Instagram @amartstore_salerno
            </a>
        </div>
    </section>

    <script>
        // ── Lookbook mobile: dot indicator sync ──
        const strip = document.getElementById("lookbook-strip");
        const dots = document.querySelectorAll(".lookbook-dot");

        if (strip && dots.length) {
            const cards = strip.querySelectorAll(".lookbook-card");
            const total = cards.length;

            function updateDots() {
                const cardW = cards[0]?.offsetWidth ?? 0;
                const gap = 16;
                const idx = Math.round(strip.scrollLeft / (cardW + gap));
                dots.forEach((d, i) => {
                    d.classList.toggle("w-5", i === idx);
                    d.classList.toggle("w-2", i !== idx);
                    d.classList.toggle("bg-navy", i === idx);
                    d.classList.toggle("bg-navy/25", i !== idx);
                });
            }

            strip.addEventListener("scroll", updateDots, { passive: true });
            updateDots();
        }
    </script>
</Layout>
