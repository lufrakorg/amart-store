---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Negozio & Ordini — Amart Store Salerno | Via dei Mercanti 131"
    description="Amart Store Salerno — Contatti diretti, WhatsApp +39 347 266 2754, orari di apertura, spedizioni 24/48h e ritiro su appuntamento in Via dei Mercanti 131."
    activePage="acquista"
>
    <!-- ===== PAGE HEADER ===== -->
    <section
        class="py-20 bg-navy-dark border-b border-gold/20 relative overflow-hidden"
        aria-label="Intestazione Negozio"
    >
        <div
            class="absolute inset-0 bg-gradient-to-r from-navy-dark via-navy to-navy-dark opacity-90"
        >
        </div>
        <div
            class="absolute -top-24 right-0 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"
        >
        </div>

        <div class="w-full max-w-[1200px] mx-auto px-6 fade-in relative z-10">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-gold/30 text-gold-light text-[0.68rem] font-bold tracking-[0.16em] uppercase mb-3"
            >
                <span>📍</span>
                <span data-i18n="acquista.header_eyebrow"
                    >Contatti, Ordini &amp; Sede</span
                >
            </div>
            <h1
                class="font-serif font-light text-white mb-4"
                style="font-size:clamp(2.4rem,5.5vw,4.2rem)"
                data-i18n="acquista.header_title"
            >
                Modalità di Acquisto &amp; Visita
            </h1>
            <p
                class="text-[0.95rem] text-white/75 font-normal max-w-[540px] leading-[1.8]"
                data-i18n="acquista.header_desc"
            >
                Siamo in Via dei Mercanti 131 a Salerno. Ordina comodamente
                online su WhatsApp o vieni a trovarci.
            </p>
        </div>
    </section>

    <!-- ===== CANALI DI CONTATTO ===== -->
    <section class="py-20 bg-beige-light border-b border-beige-dark">
        <div class="w-full max-w-[1200px] mx-auto px-6">
            <div class="mb-14 fade-in text-center md:text-left">
                <p
                    class="text-[0.7rem] font-bold tracking-[0.22em] uppercase text-gold-dark mb-2"
                    data-i18n="acquista.contacts_eyebrow"
                >
                    Canali Diretti
                </p>
                <h2
                    class="font-serif font-semibold text-navy mb-3"
                    style="font-size:clamp(2rem,3.8vw,3rem)"
                    data-i18n="acquista.contacts_title"
                >
                    Mettiti in Contatto con Noi
                </h2>
                <div class="w-10 h-[2px] bg-gold md:mx-0 mx-auto rounded-full">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 fade-in">
                <!-- Telefono -->
                <a
                    href="tel:+393472662754"
                    class="group flex flex-col justify-between p-7 md:p-8 bg-white border border-beige-dark/90 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_18px_40px_rgba(27,46,80,0.08)] hover:border-gold/60"
                >
                    <div>
                        <div class="flex items-center justify-between mb-7">
                            <div
                                class="w-14 h-14 rounded-2xl bg-navy border border-gold/40 flex items-center justify-center text-gold-light group-hover:bg-gold group-hover:text-navy-dark group-hover:border-gold transition-all duration-300 shadow-sm"
                            >
                                <svg
                                    class="w-6 h-6"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                >
                                    <path
                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                    ></path>
                                </svg>
                            </div>
                            <span
                                class="text-[0.62rem] font-bold tracking-[0.16em] uppercase text-gold-dark bg-gold/15 px-3 py-1.5 rounded-full border border-gold/30"
                                data-i18n="acquista.phone_tag">Telefono</span
                            >
                        </div>
                        <h3
                            class="font-serif text-[1.35rem] font-semibold text-navy mb-2 group-hover:text-gold-dark transition-colors duration-200"
                            data-i18n="acquista.phone_title"
                        >
                            Chiamata Diretta
                        </h3>
                        <p
                            class="text-[0.88rem] text-slate-600 font-normal leading-[1.7]"
                            data-i18n="acquista.phone_desc"
                        >
                            +39 347 266 2754 — supporto telefonico negli orari
                            di apertura del negozio.
                        </p>
                    </div>
                    <div
                        class="mt-8 pt-5 border-t border-beige-dark/60 flex items-center justify-between text-[0.72rem] font-bold tracking-[0.16em] uppercase text-navy group-hover:text-gold-dark"
                    >
                        <span data-i18n="acquista.phone_btn">Chiama Ora</span>
                        <span
                            class="text-base transition-transform duration-300 group-hover:translate-x-1.5"
                            >→</span
                        >
                    </div>
                </a>

                <!-- WhatsApp -->
                <a
                    href="https://wa.me/393472662754"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex flex-col justify-between p-7 md:p-8 bg-white border border-beige-dark/90 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_18px_40px_rgba(27,46,80,0.08)] hover:border-gold/60"
                >
                    <div>
                        <div class="flex items-center justify-between mb-7">
                            <div
                                class="w-14 h-14 rounded-2xl bg-navy border border-gold/40 flex items-center justify-center text-gold-light group-hover:bg-gold group-hover:text-navy-dark group-hover:border-gold transition-all duration-300 shadow-sm"
                            >
                                <svg
                                    class="w-6 h-6"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                >
                                    <path
                                        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                                    ></path>
                                </svg>
                            </div>
                            <span
                                class="text-[0.62rem] font-bold tracking-[0.16em] uppercase text-gold-dark bg-gold/15 px-3 py-1.5 rounded-full border border-gold/30"
                                data-i18n="acquista.wa_tag">WhatsApp</span
                            >
                        </div>
                        <h3
                            class="font-serif text-[1.35rem] font-semibold text-navy mb-2 group-hover:text-gold-dark transition-colors duration-200"
                            data-i18n="acquista.wa_title"
                        >
                            WhatsApp Direct
                        </h3>
                        <p
                            class="text-[0.88rem] text-slate-600 font-normal leading-[1.7]"
                            data-i18n="acquista.wa_desc"
                        >
                            Consigli di stile, verifica taglie e colori, ordini
                            immediati e prenotazione ritiro in sede.
                        </p>
                    </div>
                    <div
                        class="mt-8 pt-5 border-t border-beige-dark/60 flex items-center justify-between text-[0.72rem] font-bold tracking-[0.16em] uppercase text-navy group-hover:text-gold-dark"
                    >
                        <span data-i18n="acquista.wa_btn"
                            >Scrivici su WhatsApp</span
                        >
                        <span
                            class="text-base transition-transform duration-300 group-hover:translate-x-1.5"
                            >→</span
                        >
                    </div>
                </a>

                <!-- Instagram -->
                <a
                    href="https://www.instagram.com/amartstore_salerno?igsi=c2NyNHp3MXhzczZi&utm_source=qr"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex flex-col justify-between p-7 md:p-8 bg-white border border-beige-dark/90 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_18px_40px_rgba(27,46,80,0.08)] hover:border-gold/60"
                >
                    <div>
                        <div class="flex items-center justify-between mb-7">
                            <div
                                class="w-14 h-14 rounded-2xl bg-navy border border-gold/40 flex items-center justify-center text-gold-light group-hover:bg-gold group-hover:text-navy-dark group-hover:border-gold transition-all duration-300 shadow-sm"
                            >
                                <svg
                                    class="w-6 h-6"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                >
                                    <rect
                                        x="2"
                                        y="2"
                                        width="20"
                                        height="20"
                                        rx="5"></rect>
                                    <path
                                        d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                    ></path>
                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                                    ></line>
                                </svg>
                            </div>
                            <span
                                class="text-[0.62rem] font-bold tracking-[0.16em] uppercase text-gold-dark bg-gold/15 px-3 py-1.5 rounded-full border border-gold/30"
                                data-i18n="acquista.ig_tag">Instagram</span
                            >
                        </div>
                        <h3
                            class="font-serif text-[1.35rem] font-semibold text-navy mb-2 group-hover:text-gold-dark transition-colors duration-200"
                            data-i18n="acquista.ig_title"
                        >
                            Instagram Ufficiale
                        </h3>
                        <p
                            class="text-[0.88rem] text-slate-600 font-normal leading-[1.7]"
                            data-i18n="acquista.ig_desc"
                        >
                            @amartstore_salerno — novità giornaliere, video dei
                            capi indossati e consigli di outfit.
                        </p>
                    </div>
                    <div
                        class="mt-8 pt-5 border-t border-beige-dark/60 flex items-center justify-between text-[0.72rem] font-bold tracking-[0.16em] uppercase text-navy group-hover:text-gold-dark"
                    >
                        <span data-i18n="acquista.ig_btn">Apri Instagram</span>
                        <span
                            class="text-base transition-transform duration-300 group-hover:translate-x-1.5"
                            >→</span
                        >
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- ===== SPEDIZIONI & RITIRO IN DETTAGLIO ===== -->
    <section class="py-16 bg-white border-b border-beige-dark">
        <div class="w-full max-w-[1200px] mx-auto px-6">
            <div
                class="bg-gradient-to-br from-beige-light via-white to-beige-light border border-gold/40 rounded-3xl p-8 sm:p-12 shadow-sm"
            >
                <div class="max-w-2xl mb-8">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold/15 border border-gold/35 text-gold-dark text-[0.65rem] font-bold tracking-[0.18em] uppercase mb-2"
                    >
                        <span>📦</span>
                        <span data-i18n="services.eyebrow"
                            >Spedizioni &amp; Ritiro</span
                        >
                    </div>
                    <h2
                        class="font-serif text-[1.7rem] sm:text-[2.2rem] text-navy font-semibold"
                        data-i18n="shipping.box_title"
                    >
                        Informazioni su Spedizioni &amp; Ritiro
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div
                        class="bg-white p-7 rounded-2xl border border-beige-dark shadow-sm hover:border-gold/40 transition-colors"
                    >
                        <div
                            class="w-10 h-10 rounded-xl bg-gold/15 text-gold-dark flex items-center justify-center mb-4"
                        >
                            <svg
                                class="w-5 h-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <h4
                            class="font-bold text-navy text-[0.95rem] mb-2"
                            data-i18n="shipping.box_item1_label"
                        >
                            Tempi Medi Spedizione
                        </h4>
                        <p
                            class="text-[0.85rem] text-slate-600 leading-[1.65]"
                            data-i18n="shipping.box_item1_val"
                        >
                            24/48 ore lavorative con corriere espresso in tutta
                            Italia
                        </p>
                    </div>

                    <div
                        class="bg-white p-7 rounded-2xl border border-beige-dark shadow-sm hover:border-gold/40 transition-colors"
                    >
                        <div
                            class="w-10 h-10 rounded-xl bg-gold/15 text-gold-dark flex items-center justify-center mb-4"
                        >
                            <svg
                                class="w-5 h-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <rect
                                    x="3"
                                    y="4"
                                    width="18"
                                    height="18"
                                    rx="2"
                                    ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <h4
                            class="font-bold text-navy text-[0.95rem] mb-2"
                            data-i18n="shipping.box_item2_label"
                        >
                            Giorni Operativi
                        </h4>
                        <p
                            class="text-[0.85rem] text-slate-600 leading-[1.65]"
                            data-i18n="shipping.box_item2_val"
                        >
                            Lunedì – Venerdì (spedizioni non operative nei
                            giorni festivi)
                        </p>
                    </div>

                    <div
                        class="bg-white p-7 rounded-2xl border border-beige-dark shadow-sm hover:border-gold/40 transition-colors"
                    >
                        <div
                            class="w-10 h-10 rounded-xl bg-gold/15 text-gold-dark flex items-center justify-center mb-4"
                        >
                            <svg
                                class="w-5 h-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <path
                                    d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                                ></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <h4
                            class="font-bold text-navy text-[0.95rem] mb-2"
                            data-i18n="shipping.box_item3_label"
                        >
                            Ritiro in Negozio
                        </h4>
                        <p
                            class="text-[0.85rem] text-slate-600 leading-[1.65]"
                            data-i18n="shipping.box_item3_val"
                        >
                            Disponibile gratuitamente su appuntamento in Via dei
                            Mercanti 131, Salerno
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== QUICK ACTIONS ===== -->
    <section class="py-14 bg-beige border-b border-beige-dark">
        <div class="w-full max-w-[1200px] mx-auto px-6">
            <div class="mb-8 fade-in">
                <p
                    class="text-[0.65rem] font-bold tracking-[0.22em] uppercase text-gold-dark mb-2"
                    data-i18n="acquista.quick_eyebrow"
                >
                    Info Rapide
                </p>
                <h2
                    class="font-serif font-semibold text-navy text-[1.8rem]"
                    data-i18n="acquista.quick_title"
                >
                    Orari &amp; Servizi
                </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 fade-in">
                <button
                    class="quick-btn flex flex-col items-center gap-3 py-6 px-4 bg-white border border-beige-dark rounded-2xl hover:border-gold hover:shadow-md transition-all duration-200 cursor-pointer group hover:scale-[1.02]"
                    data-modal-open="modal-orari"
                >
                    <div
                        class="w-10 h-10 rounded-full bg-navy/5 group-hover:bg-gold/15 flex items-center justify-center transition-colors"
                    >
                        <svg
                            class="w-5 h-5 text-navy group-hover:text-gold transition-colors"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <span
                        class="text-[0.68rem] font-bold tracking-[0.14em] uppercase text-navy"
                        data-i18n="acquista.quick_hours">Orari di Apertura</span
                    >
                </button>

                <a
                    href="https://maps.google.com/?q=Via+dei+Mercanti+131,+84121+Salerno&t=k"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex flex-col items-center gap-3 py-6 px-4 bg-white border border-beige-dark rounded-2xl hover:border-gold hover:shadow-md transition-all duration-200 group hover:scale-[1.02]"
                >
                    <div
                        class="w-10 h-10 rounded-full bg-navy/5 group-hover:bg-gold/15 flex items-center justify-center transition-colors"
                    >
                        <svg
                            class="w-5 h-5 text-navy group-hover:text-gold transition-colors"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >
                            <path
                                d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                            ></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <span
                        class="text-[0.68rem] font-bold tracking-[0.14em] uppercase text-navy"
                        data-i18n="acquista.quick_map">Indicazioni Mappa</span
                    >
                </a>

                <a
                    href="https://wa.me/393472662754"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex flex-col items-center gap-3 py-6 px-4 bg-white border border-beige-dark rounded-2xl hover:border-gold hover:shadow-md transition-all duration-200 group hover:scale-[1.02]"
                >
                    <div
                        class="w-10 h-10 rounded-full bg-navy/5 group-hover:bg-gold/15 flex items-center justify-center transition-colors"
                    >
                        <svg
                            class="w-5 h-5 text-navy group-hover:text-gold transition-colors"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >
                            <path
                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                            ></path>
                        </svg>
                    </div>
                    <span
                        class="text-[0.68rem] font-bold tracking-[0.14em] uppercase text-navy"
                        data-i18n="acquista.quick_write"
                        >Chatta su WhatsApp</span
                    >
                </a>
            </div>
        </div>
    </section>

    <!-- ===== MAPPA + STORE INFO ===== -->
    <section class="py-20 bg-beige-light border-b border-beige-dark">
        <div class="w-full max-w-[1200px] mx-auto px-6">
            <div class="mb-12 fade-in">
                <p
                    class="text-[0.65rem] font-bold tracking-[0.22em] uppercase text-gold-dark mb-3"
                    data-i18n="acquista.store_eyebrow"
                >
                    Negozio di Salerno
                </p>
                <h2
                    class="font-serif font-semibold text-navy mb-4"
                    style="font-size:clamp(1.8rem,4vw,3rem)"
                    data-i18n="acquista.store_title"
                >
                    Punto Vendita Amart Store Salerno
                </h2>
                <div class="w-10 h-[2px] bg-gold rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                <!-- Map embed -->
                <div
                    class="fade-in rounded-3xl overflow-hidden border border-beige-dark aspect-video lg:aspect-auto lg:h-[440px] shadow-sm"
                >
                    <iframe
                        src="https://maps.google.com/maps?q=Via%20dei%20Mercanti%20131,%20Salerno&t=k&z=17&ie=UTF8&iwloc=&output=embed"
                        title="Mappa Negozio Amart Store Salerno (Vista Satellitare)"
                        loading="lazy"
                        allowfullscreen
                        class="w-full h-full border-0 min-h-[320px]"></iframe>
                </div>

                <!-- Store info -->
                <div class="fade-in delay-1 flex flex-col gap-6">
                    <div
                        class="flex gap-4 items-start bg-white p-5 rounded-2xl border border-beige-dark shadow-sm"
                    >
                        <div
                            class="w-11 h-11 rounded-xl bg-gold/15 text-navy flex items-center justify-center flex-shrink-0 mt-0.5"
                        >
                            <svg
                                class="w-5 h-5 text-gold-dark"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <path
                                    d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                                ></path><circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <div>
                            <p
                                class="text-[0.65rem] font-bold tracking-[0.16em] uppercase text-gold-dark mb-1"
                                data-i18n="acquista.store_address_label"
                            >
                                Indirizzo Negozio
                            </p>
                            <p
                                class="text-[0.98rem] text-navy font-semibold leading-[1.6]"
                                data-i18n="acquista.store_address_val"
                            >
                                Via dei Mercanti 131, 84121 Salerno (SA)
                            </p>
                        </div>
                    </div>

                    <div
                        class="flex gap-4 items-start bg-white p-5 rounded-2xl border border-beige-dark shadow-sm"
                    >
                        <div
                            class="w-11 h-11 rounded-xl bg-gold/15 text-navy flex items-center justify-center flex-shrink-0 mt-0.5"
                        >
                            <svg
                                class="w-5 h-5 text-gold-dark"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <circle cx="12" cy="12" r="10"
                                ></circle><polyline points="12 6 12 12 16 14"
                                ></polyline>
                            </svg>
                        </div>
                        <div>
                            <p
                                class="text-[0.65rem] font-bold tracking-[0.16em] uppercase text-gold-dark mb-1.5"
                                data-i18n="acquista.store_hours_label"
                            >
                                Orari di Apertura
                            </p>
                            <p
