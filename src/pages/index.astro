        >
            <div
                class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-gold/10 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-16 -right-16 w-80 h-80 rounded-full bg-sea/10 blur-3xl"
            >
            </div>
        </div>
        <div class="w-full max-w-[1200px] mx-auto px-6 fade-in relative z-10">
            <div
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-gold/30 text-gold-light text-[0.68rem] font-bold tracking-[0.16em] uppercase mb-4"
            >
                <span>📍</span>
                <span>Salerno Centro Storico · Via dei Mercanti 131</span>
            </div>
            <h2
                class="font-serif font-semibold text-white mb-4"
                style="font-size:clamp(1.9rem,4vw,3.2rem)"
