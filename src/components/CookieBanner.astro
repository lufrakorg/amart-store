---
// CookieBanner.astro - Conforme alle Linee Guida Cookie del Garante Privacy e GDPR
---

<div
    id="cookie-banner"
    class="fixed bottom-20 md:bottom-6 left-4 right-4 md:left-auto md:right-6 md:max-w-[460px] z-[250] bg-navy-dark/95 backdrop-blur-xl border border-gold/40 rounded-2xl p-5 shadow-[0_16px_50px_rgba(11,19,38,0.6)] text-white transform transition-all duration-[400ms] translate-y-8 opacity-0 pointer-events-none"
    role="region"
    aria-label="Informativa Cookie"
>
    <div class="flex items-start gap-3.5 mb-3">
        <div class="w-8 h-8 rounded-full bg-gold/15 border border-gold/40 flex items-center justify-center text-gold-light flex-shrink-0 mt-0.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
            </svg>
        </div>
        <div>
            <h3 class="font-serif text-sm font-semibold text-white tracking-wide" data-i18n="cookie.banner_title">
                Informativa sui Cookie
            </h3>
            <p class="text-[0.78rem] leading-[1.65] text-white/75 mt-1" data-i18n="cookie.banner_desc">
                Questo sito non utilizza cookie di profilazione, né proprietari né di terze parti. Utilizziamo esclusivamente strumenti e cookie tecnici necessari per il corretto funzionamento e per memorizzare le tue preferenze.
            </p>
        </div>
    </div>

    <div class="flex items-center justify-between gap-3 pt-2 border-t border-white/10 mt-3">
        <a
            href="/cookie"
            class="text-[0.74rem] text-gold-light underline hover:text-white transition-colors duration-200"
            data-i18n="cookie.learn_more"
        >
            Scopri di più
        </a>
        <div class="flex items-center gap-2">
            <button
                type="button"
                id="cookie-btn-necessary"
                class="text-[0.72rem] font-semibold uppercase tracking-wider px-3 py-1.5 rounded-full border border-white/25 text-white/80 hover:text-white hover:border-white/50 transition-all duration-200 cursor-pointer"
                data-i18n="cookie.accept_necessary"
            >
                Solo Necessari
            </button>
            <button
                type="button"
                id="cookie-btn-accept-all"
                class="text-[0.72rem] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full bg-gold text-navy-dark hover:bg-gold-light transition-all duration-200 cursor-pointer shadow-sm"
                data-i18n="cookie.accept_all"
            >
                Accetta Tutti
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        const banner = document.getElementById("cookie-banner");
        const btnAcceptAll = document.getElementById("cookie-btn-accept-all");
        const btnNecessary = document.getElementById("cookie-btn-necessary");

        if (!banner) return;

        function showBanner() {
            banner.classList.remove("translate-y-8", "opacity-0", "pointer-events-none");
            banner.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
        }

        function hideBanner() {
            banner.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
            banner.classList.add("translate-y-8", "opacity-0", "pointer-events-none");
        }

        try {
            const consent = localStorage.getItem("amart_cookie_consent");
            if (!consent) {
                // Show after brief delay for smooth appearance
                setTimeout(showBanner, 800);
            }
        } catch (e) {
            // LocalStorage might be restricted
            showBanner();
        }

        function saveConsent(value: string) {
            try {
                localStorage.setItem("amart_cookie_consent", value);
                localStorage.setItem("amart_cookie_consent_date", new Date().toISOString());
            } catch (e) {}
            hideBanner();

            // Dispatch event so other components or settings listeners can react
            window.dispatchEvent(new CustomEvent("amart-cookie-consent-changed", { detail: value }));
        }

        btnAcceptAll?.addEventListener("click", () => saveConsent("all"));
        btnNecessary?.addEventListener("click", () => saveConsent("necessary"));

        // Global opener for footer button or Cookie Policy page
        (window as any).openCookieSettings = () => {
            showBanner();
        };

        const footerOpenBtn = document.getElementById("open-cookie-settings-btn");
        footerOpenBtn?.addEventListener("click", () => {
            showBanner();
        });
    })();
</script>
