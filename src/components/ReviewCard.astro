---
export interface Props {
  initials: string;
  name: string;
  city: string;
  stars: number;
  body: string;
}

const { initials, name, city, stars, body } = Astro.props;
const fullStars  = Math.min(5, Math.max(0, Math.floor(stars)));
const emptyStars = 5 - fullStars;
---

<article class="review-card relative w-[300px] md:w-[380px] flex-shrink-0 bg-white/95 backdrop-blur-sm border border-beige-dark/90 hover:border-gold/60 p-7 rounded-2xl shadow-[0_4px_20px_rgba(17,30,56,0.04)] transition-all duration-[400ms] hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(17,30,56,0.1)] group overflow-hidden" data-author={name} data-orig-body={body} data-orig-city={city}>
  <!-- Background quote accent -->
  <div class="absolute top-3 right-4 text-gold/10 group-hover:text-gold/25 transition-colors duration-[400ms] font-serif text-6xl select-none pointer-events-none leading-none">
    “
  </div>

  <div class="relative z-10 flex items-center justify-between gap-4 mb-5">
    <div class="flex items-center gap-3.5">
      <div class="w-11 h-11 border border-gold/40 bg-navy-dark flex items-center justify-center font-serif text-[1.05rem] font-medium text-gold-light flex-shrink-0 rounded-full group-hover:scale-110 group-hover:border-gold group-hover:shadow-[0_0_12px_rgba(212,168,75,0.35)] transition-all duration-300 shadow-sm">
        {initials}
      </div>
      <div>
        <p class="text-[0.92rem] font-semibold text-navy group-hover:text-gold-dark transition-colors duration-200">{name}</p>
        <p class="review-city text-[0.75rem] font-medium text-slate-400 uppercase tracking-widest">{city}</p>
      </div>
    </div>
    <div class="flex gap-0.5 text-gold text-[0.9rem] group-hover:scale-105 transition-transform duration-300">
      {Array.from({ length: fullStars }).map(() => <span class="drop-shadow-[0_1px_2px_rgba(197,160,89,0.3)]">★</span>)}
      {Array.from({ length: emptyStars }).map(() => <span class="text-gray-300">★</span>)}
    </div>
  </div>

  <p class="relative z-10 review-body font-serif text-[1.08rem] font-normal italic text-slate-700 leading-[1.75]">
    {body}
  </p>
</article>
