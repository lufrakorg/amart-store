                    <!-- Brand -->
                    <div>
                        <div class="flex items-center gap-3 mb-4">
                            <img
                                src="/logo.png"
                                alt="Amart Store Salerno Logo"
                                class="w-11 h-11 object-contain flex-shrink-0 drop-shadow-[0_2px_8px_rgba(0,0,0,0.35)]"
                                width="44"
                                height="44"
                            />
                            <div class="flex flex-col leading-none">
