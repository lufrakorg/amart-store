---
import "../styles/global.css";

export interface Props {
    title: string;
    description: string;
    activePage: "home" | "collezione" | "acquista";
}

const { title, description, activePage } = Astro.props;
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#1B2E50" />
        <meta name="robots" content="index, follow" />
        <title>{title}</title>
        <meta name="author" content="GA.SA.SRLS — Amart Store Salerno" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="it_IT" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin="anonymous"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito:wght@300;400;500;600;700&display=swap"
        />
        <link rel="icon" href="/favicon.ico" />

        <script is:inline>
            // Early smartphone & language auto-detection to prevent flash
            (function () {
                try {
                    var saved = localStorage.getItem("amart_user_lang");
                    var isMobile =
                        window.innerWidth <= 768 ||
                        /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
                            navigator.userAgent,
                        ) ||
                        (navigator.maxTouchPoints > 0 &&
                            window.innerWidth <= 1024);
                    var navLang = (
                        navigator.language ||
                        navigator.userLanguage ||
                        ""
                    ).toLowerCase();
                    var isItalian = navLang.indexOf("it") === 0;
                    var lang =
                        saved === "it" || saved === "en"
                            ? saved
                            : isMobile && !isItalian
                              ? "en"
                              : "it";
                    document.documentElement.lang = lang;
                } catch (e) {}
            })();
        </script>
        <script src="https://cdn.jsdelivr.net/npm/netlify-identity-widget@1.9.1/build/netlify-identity-widget.min.js"></script>
    </head>
    <body
        class="font-sans font-light text-navy bg-beige-light antialiased overflow-x-hidden pb-[74px] sm:pb-[84px] pt-[84px] md:pb-0"
    >
        <!-- ===== HEADER ===== -->
        <header
            class="site-header fixed top-3 sm:top-4 left-1/2 -translate-x-1/2 w-[calc(100%-24px)] sm:w-[calc(100%-40px)] max-w-[1100px] h-[58px] sm:h-[64px] bg-navy/90 backdrop-blur-xl border border-gold/30 rounded-full z-[200] flex items-center px-4 sm:px-6 shadow-[0_8px_32px_rgba(27,46,80,0.35)] transition-all duration-300"
        >
            <div class="w-full flex items-center justify-between">
                <!-- Logo & Brand Name -->
                <a
                    href="/"
                    class="flex items-center gap-2.5 sm:gap-3 no-underline group py-1"
                    aria-label="Amart Store Salerno Home"
                >
                    <img
                        src="/logo.png"
                        alt="Amart Store Salerno Logo"
                        class="w-10 h-10 sm:w-11 sm:h-11 object-contain flex-shrink-0 drop-shadow-[0_2px_8px_rgba(0,0,0,0.35)] transition-transform duration-300 group-hover:scale-105"
                        width="44"
                        height="44"
                    />
                    <div class="flex flex-col justify-center leading-none">
                        <span
                            class="font-serif text-[1.02rem] sm:text-[1.12rem] font-semibold tracking-[0.08em] text-white uppercase drop-shadow-md group-hover:text-gold-light transition-colors duration-200"
                            >AMART STORE SALERNO</span
                        >
                        <span
                            class="text-[0.5rem] sm:text-[0.55rem] font-semibold tracking-[0.16em] text-gold-light/80 uppercase mt-0.5"
                            data-i18n="nav.slogan"
                            >La praticità prima di tutto</span
                        >
                    </div>
                </a>

                <!-- Desktop Nav & Language Switcher -->
                <div class="flex items-center gap-3 sm:gap-4">
                    <nav
                        id="desktop-nav"
                        class="hidden md:flex items-center gap-1.5"
                        aria-label="Navigazione principale"
                    >
                        <a
                            href="/"
                            data-navpage="home"
                            data-active={activePage === "home"
                                ? "true"
                                : "false"}
                            class={`text-[0.72rem] font-semibold tracking-[0.12em] uppercase px-4 py-2 rounded-full transition-all duration-200 ${activePage === "home" ? "text-gold-light bg-gold/15 border border-gold/40 shadow-[0_0_12px_rgba(212,168,75,0.2)]" : "text-white/80 hover:text-gold-light hover:bg-white/10"}`}
                            data-i18n="nav.home">Home</a
                        >
                        <a
                            href="/collezione"
                            data-navpage="collezione"
                            data-active={activePage === "collezione"
                                ? "true"
                                : "false"}
                            class={`text-[0.72rem] font-semibold tracking-[0.12em] uppercase px-4 py-2 rounded-full transition-all duration-200 ${activePage === "collezione" ? "text-gold-light bg-gold/15 border border-gold/40 shadow-[0_0_12px_rgba(212,168,75,0.2)]" : "text-white/80 hover:text-gold-light hover:bg-white/10"}`}
                            data-i18n="nav.collection">Collezione</a
                        >
                        <a
                            href="/acquista"
                            data-navpage="acquista"
                            data-active={activePage === "acquista"
                                ? "true"
                                : "false"}
                            class={`text-[0.72rem] font-bold tracking-[0.12em] uppercase px-5 py-2 rounded-full transition-all duration-200 shadow-md ${activePage === "acquista" ? "bg-gold-light text-navy-dark ring-2 ring-gold/80" : "bg-gold text-navy-dark hover:bg-gold-light hover:scale-105"}`}
                            data-i18n="nav.shop">Negozio & Ordini</a
                        >
                    </nav>

                    <!-- Language Switcher Pill -->
                    <div
                        id="lang-switcher"
                        class="relative inline-flex items-center justify-center p-[3px] bg-white/10 backdrop-blur-md border border-gold/30 rounded-full text-[0.66rem] select-none"
                        aria-label="Seleziona lingua / Select language"
                    >
                        <div
                            id="lang-bubble"
                            class="absolute pointer-events-none rounded-full box-border"
                            aria-hidden="true"
                        >
                        </div>
                        <button
                            data-lang-btn="it"
                            class="relative z-10 w-[32px] h-[24px] p-0 flex items-center justify-center rounded-full transition-all duration-200 cursor-pointer font-semibold leading-none text-white/50 hover:text-white"
                            aria-label="Italiano">IT</button
                        >
                        <button
                            data-lang-btn="en"
                            class="relative z-10 w-[32px] h-[24px] p-0 flex items-center justify-center rounded-full transition-all duration-200 cursor-pointer font-semibold leading-none text-white/50 hover:text-white"
                            aria-label="English">EN</button
                        >
                    </div>
                </div>
            </div>
        </header>

        <!-- ===== SLOT ===== -->
        <slot />

        <!-- ===== FOOTER ===== -->
        <footer
            class="bg-navy text-white/50 pt-14 pb-[calc(64px+74px)] md:pb-14 border-t border-gold/15"
        >
            <div class="w-full max-w-[1200px] mx-auto px-6">
                <div
                    class="grid grid-cols-1 sm:grid-cols-[2fr_1fr_1fr] lg:grid-cols-[3fr_1fr_1fr_1fr] gap-12 border-b border-white/8 pb-12 mb-8"
